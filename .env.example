PORT=3000
DB_HOST=127.0.0.1
DB_USER=root
DB_PASSWORD=
DB_NAME=pasar_desa
DB_PORT=3306
JWT_SECRET=isi_dengan_string_acak_minimal_32_karakter
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Origin yang boleh memanggil API, pisahkan dengan koma. Kosong = semua (hanya untuk dev).
CORS_ORIGIN=

# ---- Midtrans (Snap) ----
# Sandbox: https://dashboard.sandbox.midtrans.com → Settings → Access Keys. Kunci sandbox berawalan "SB-".
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false
# Alamat PUBLIK backend (untuk halaman selesai WebView). Notifikasi Midtrans diarahkan ke:
#   {PUBLIC_BASE_URL}/api/payments/midtrans/notification   (isi di Dashboard Midtrans → Settings → Payment → Notification URL)
# Saat dev lokal pakai tunnel, mis. `ngrok http 3000`.
PUBLIC_BASE_URL=
# Batas bayar dalam menit (dashboard menyebut 15 menit).
PAYMENT_WINDOW_MINUTES=15
# Ongkir kurir desa & nilai voucher PANENRAYA (rupiah) — dihitung server.
ONGKIR_KURIR_DESA=5000
VOUCHER_PANENRAYA_NILAI=5000
