{
  "info": {
    "name": "PasarDesa Backend",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {"key":"baseUrl","value":"http://localhost:3000/api"},
    {"key":"token","value":""},
    {"key":"productId","value":""},
    {"key":"orderId","value":""}
  ],
  "item": [
    {"name":"Health","request":{"method":"GET","url":"{{baseUrl}}/health"}},
    {"name":"Auth","item":[
      {"name":"Register","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\n  \"name\": \"Nama Pengguna\",\n  \"email\": \"email@contoh.com\",\n  \"phone\": \"081234567890\",\n  \"password\": \"123456\",\n  \"confirmPassword\": \"123456\"\n}"},"url":"{{baseUrl}}/auth/register"}},
      {"name":"Login","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\n  \"emailOrPhone\": \"email@contoh.com\",\n  \"password\": \"123456\"\n}"},"url":"{{baseUrl}}/auth/login"}},
      {"name":"Forgot Password","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\n  \"email\": \"email@contoh.com\"\n}"},"url":"{{baseUrl}}/auth/forgot-password"}}
    ]},
    {"name":"Products","item":[
      {"name":"List","request":{"method":"GET","url":"{{baseUrl}}/products"}},
      {"name":"Detail","request":{"method":"GET","url":"{{baseUrl}}/products/{{productId}}"}}
    ]},
    {"name":"Categories","request":{"method":"GET","url":"{{baseUrl}}/categories"}},
    {"name":"Profile","request":{"method":"GET","header":[{"key":"Authorization","value":"Bearer {{token}}"}],"url":"{{baseUrl}}/users/profile"}},
    {"name":"Cart","request":{"method":"GET","header":[{"key":"Authorization","value":"Bearer {{token}}"}],"url":"{{baseUrl}}/cart"}},
    {"name":"Orders","request":{"method":"GET","header":[{"key":"Authorization","value":"Bearer {{token}}"}],"url":"{{baseUrl}}/orders"}},
    {"name":"Addresses","request":{"method":"GET","header":[{"key":"Authorization","value":"Bearer {{token}}"}],"url":"{{baseUrl}}/addresses"}},
    {"name":"Wallet","request":{"method":"GET","header":[{"key":"Authorization","value":"Bearer {{token}}"}],"url":"{{baseUrl}}/wallet"}}
  ]
}
